; ELXVRO Blocks 3D Prototype
; Godot 4.3

config_version=5

[application]

config/name="ELXVRO Blocks 3D Prototype"
config/description="Experimental 3D visual rebuild prototype for ELXVRO Blocks"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.045, 1)
anti_aliasing/quality/msaa_3d=2

[physics]

common/physics_ticks_per_second=60
