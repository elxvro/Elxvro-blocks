@@ -0,0 +1,37 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:elxvro_blocks/services/wallet_snapshot.dart';
+import 'package:elxvro_blocks/services/billing_account_service.dart';
+void main() {
+  Map<String,dynamic> valid() => {'protocol':3,'source':'verified_purchases',
+    'balance':1500,'revision':4,'supporter':true,'checkoutEnabled':false,
+    'inventory':{'undo':3,'refresh':0,'special':2},'themes':['night']};
+  test('authoritative snapshot restores purchased assets without local minting', () {
+    final w=WalletSnapshot.fromJson(valid());
+    expect(w.balance,1500);expect(w.supporter,isTrue);expect(w.inventory['undo'],3);
+    expect(w.themes,contains('night'));expect(w.checkoutEnabled,isFalse);
+  });
+  test('malformed monetary and inventory fields fail closed', () {
+    for(final key in ['balance','revision']) {
+      for(final value in [-1,'1500',null,1.5]) {
+        final data=valid()..[key]=value;
+        expect(()=>WalletSnapshot.fromJson(data),throwsFormatException);
+      }
+    }
+    final data=valid()..['inventory']={'undo':-1,'refresh':0,'special':2};
+    expect(()=>WalletSnapshot.fromJson(data),throwsFormatException);
+    expect(()=>WalletSnapshot.fromJson({'balance':999999}),throwsFormatException);
+  });
+  test('last-item response loss remains recoverable after wallet reload', () {
+    final data=valid()..['inventory']={'undo':0,'refresh':0,'special':0};
+    final reloaded=WalletSnapshot.fromJson(data);
+    expect(reloaded.recoverableInventory('special','special'),1);
+    expect(reloaded.recoverableInventory('undo','special'),0);
+    expect(reloaded.recoverableInventory('special',null),0);
+    expect(WalletSnapshot.fromJson(valid()).recoverableInventory('undo','undo'),3);
+  });
+  test('operation identifiers conform to server UUID-v4 replay keys', () {
+    final ids=List.generate(100,(_)=>BillingAccountService.operationId());
+    expect(ids.toSet().length,100);
+    for(final id in ids) {expect(RegExp(r'^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$').hasMatch(id),isTrue);}
+  });
+}
