diff --git a/lib/services/wallet_snapshot.dart b/lib/services/wallet_snapshot.dart
new file mode 100644
index 0000000..d75d22f
--- /dev/null
+++ b/lib/services/wallet_snapshot.dart
@@ -0,0 +1,32 @@
+class WalletSnapshot {
+  const WalletSnapshot({required this.balance, required this.supporter,
+    required this.revision, required this.inventory, required this.themes,
+    required this.checkoutEnabled});
+  final int balance;
+  final bool supporter;
+  final int revision;
+  final Map<String, int> inventory;
+  final Set<String> themes;
+  final bool checkoutEnabled;
+  factory WalletSnapshot.fromJson(dynamic data) {
+    if (data is! Map<String, dynamic> || data['protocol'] != 3 ||
+        data['source'] != 'verified_purchases' || data['balance'] is! int ||
+        data['balance'] < 0 || data['revision'] is! int || data['revision'] < 0 ||
+        data['supporter'] is! bool || data['checkoutEnabled'] is! bool ||
+        data['inventory'] is! Map || data['themes'] is! List) {
+      throw const FormatException('Invalid wallet');
+    }
+    final inventory = <String,int>{};
+    for (final key in ['undo','refresh','special']) {
+      final value = data['inventory'][key];
+      if (value is! int || value < 0) throw const FormatException('Invalid inventory');
+      inventory[key] = value;
+    }
+    if ((data['themes'] as List).any((e) => e is! String)) {
+      throw const FormatException('Invalid themes');
+    }
+    return WalletSnapshot(balance:data['balance'], supporter:data['supporter'],
+      revision:data['revision'], inventory:inventory,
+      themes:Set<String>.from(data['themes']), checkoutEnabled:data['checkoutEnabled']);
+  }
+}
