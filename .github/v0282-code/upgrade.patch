@@ -0,0 +1,139 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:google_sign_in/google_sign_in.dart';
+import 'package:http/http.dart' as http;
+
+/// The backend validates every Google ID token. The phone is NOT trusted to
+/// authorize a wallet or mint any purchased coins.
+class BillingAccountService extends ChangeNotifier {
+  BillingAccountService._();
+  static final BillingAccountService instance = BillingAccountService._();
+
+  static const webClientId =
+      String.fromEnvironment('ELXVRO_GOOGLE_WEB_CLIENT_ID');
+  static const apiBase = 'https://block.elxvro.com';
+
+  GoogleSignIn? _google;
+  GoogleSignInAccount? _account;
+  String? _idToken;
+  bool busy = false;
+  bool walletVerified = false;
+  int purchasedCoinBalance = 0;
+  bool serverSupporter = false;
+  String? message;
+
+  bool get clientConfigured => webClientId.endsWith('.apps.googleusercontent.com');
+  bool get signedIn => _account != null && _idToken != null;
+  String? get accountEmail => _account?.email;
+  String? get googleUserId => _account?.id;
+
+  GoogleSignIn get _provider => _google ??= GoogleSignIn(
+    scopes: const <String>['email'],
+    serverClientId: webClientId,
+  );
+
+  /// Explicit sign-in; do not silently sign the user in when opening a game.
+  Future<void> signIn() async {
+    if (!clientConfigured) {
+      message = 'Google OAuth kimliği henüz APK içine tanımlanmadı.';
+      notifyListeners();
+      return;
+    }
+    busy = true;
+    message = null;
+    notifyListeners();
+    try {
+      final account = await _provider.signIn();
+      if (account == null) {
+        message = 'Google ile giriş iptal edildi.';
+        return;
+      }
+      final token = (await account.authentication).idToken;
+      if (token == null || token.isEmpty) {
+        message = 'Google kimlik jetonu alınamadı. OAuth Android SHA-1 ayarını kontrol edin.';
+        return;
+      }
+      _account = account;
+      _idToken = token;
+      await _refreshWallet();
+    } catch (_) {
+      message = 'Google giriş bağlantısı kurulamadı.';
+      walletVerified = false;
+    } finally {
+      busy = false;
+      notifyListeners();
+    }
+  }
+
+  Future<void> refreshWallet() async {
+    if (!signedIn) return;
+    busy = true;
+    notifyListeners();
+    try {
+      await _refreshWallet();
+    } finally {
+      busy = false;
+      notifyListeners();
+    }
+  }
+
+  Future<void> _refreshWallet() async {
+    walletVerified = false;
+    try {
+      final response = await http.get(
+        Uri.parse('$apiBase/wallet.php'),
+        headers: <String, String>{'Authorization': 'Bearer $_idToken'},
+      ).timeout(const Duration(seconds: 15));
+      if (response.statusCode != 200) {
+        message = response.statusCode == 401
+            ? 'Google kimlik oturumunun süresi doldu. Tekrar giriş yapın.'
+            : 'Sunucu cüzdanı açılamadı (${response.statusCode}).';
+        return;
+      }
+      final decoded = jsonDecode(response.body);
+      if (decoded is! Map<String, dynamic> ||
+          decoded['source'] != 'verified_purchases' ||
+          decoded['balance'] is! int || decoded['balance'] < 0 ||
+          decoded['supporter'] is! bool) {
+        message = 'Sunucudan geçersiz cüzdan yanıtı geldi.';
+        return;
+      }
+      purchasedCoinBalance = decoded['balance'] as int;
+      serverSupporter = decoded['supporter'] as bool;
+      walletVerified = true;
+      message = 'Google hesabı ve sunucu bağlantısı doğrulandı.';
+    } catch (_) {
+      message = 'Cüzdan bağlantısı kurulamadı. İnterneti kontrol edin.';
+    }
+  }
+
+  Future<String?> freshIdToken() async {
+    final user = _account;
+    if (user == null) return null;
+    try {
+      final token = (await user.authentication).idToken;
+      if (token == null || token.isEmpty) return null;
+      _idToken = token;
+      return token;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  Future<void> signOut() async {
+    try {
+      await _google?.signOut();
+    } catch (_) {
+      // The local session is cleared even if Google cannot be contacted.
+    }
+    _account = null;
+    _idToken = null;
+    walletVerified = false;
+    purchasedCoinBalance = 0;
+    serverSupporter = false;
+    message = 'Çıkış yapıldı.';
+    notifyListeners();
+  }
+}
