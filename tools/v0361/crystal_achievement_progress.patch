+  test('crystal adventure achievement uses persisted 300-stage progress', () async {
+    final app = AppState();
+    await app.load();
+    expect(app.achievementUnlocked('adventure_10'), isFalse);
+    app.syncCrystalAdventureCompletedCount(9);
+    expect(app.achievementUnlocked('adventure_10'), isFalse);
+    app.registerCrystalAdventureCompletion();
+    expect(app.crystalAdventureCompletedCount, 10);
+    expect(app.achievementUnlocked('adventure_10'), isTrue);
+    await Future<void>.delayed(const Duration(milliseconds: 20));
+    final reloaded = AppState();
+    await reloaded.load();
+    expect(reloaded.achievementUnlocked('adventure_10'), isTrue);
+    reloaded.syncCrystalAdventureCompletedCount(3);
+    expect(reloaded.crystalAdventureCompletedCount, 10);
