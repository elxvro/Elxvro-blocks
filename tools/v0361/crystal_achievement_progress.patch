+  int get crystalAdventureCompletedCount => _crystalAdventureClears;
+
+  /// Mirror the canonical animal/world completed sets for achievements.
+  /// The original five-world storage remains the authoritative source.
+  void syncCrystalAdventureCompletedCount(int total) {
+    if (total <= _crystalAdventureClears) return;
+    _crystalAdventureClears = total.clamp(0, 300).toInt();
+    notifyListeners();
+    unawaited(_saveCrystalAdventureCompletedCount());
+  }
+
+  void registerCrystalAdventureCompletion() {
+    syncCrystalAdventureCompletedCount(_crystalAdventureClears + 1);
+  }
+
+  Future<void> _saveCrystalAdventureCompletedCount() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      await prefs.setInt(_crystalAdventureClearsKey, _crystalAdventureClears);
+    } catch (error) {
+      debugPrint('Crystal adventure achievements save failed: $error');
+    }
+  }
