+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+
+/// Lightweight, GPU-friendly layered crystal feedback. Only this painter
+/// repaints at animation-frame frequency; the 56-image board remains static.
+class AnimalCrystalBurst extends CustomPainter {
+  AnimalCrystalBurst({
+    required this.animation,
+    required this.cells,
+    required this.before,
+    required this.palette,
+    required this.chain,
+  }) : super(repaint: animation);
+
+  final Animation<double> animation;
+  final Set<int> cells;
+  final List<int> before;
+  final List<Color> palette;
+  final int chain;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (cells.isEmpty || size.isEmpty) return;
+    final t = animation.value.clamp(0.0, 1.0);
+    final fade = (1.0 - t) * (1.0 - t);
+    final side = size.width / 7;
+    final viewport = Offset.zero & size;
+    canvas.save();
+    canvas.clipRect(viewport);
+
+    final active = cells.take(28).toList(growable: false);
+    for (final index in active) {
+      final row = index ~/ 7;
+      final col = index % 7;
+      final center = Offset((col + .5) * side, (row + .5) * side);
+      final type = before[index].clamp(0, palette.length - 1).toInt();
+      final color = palette[type];
+      final rng = math.Random(3187 + index * 103 + chain * 111);
+      final burst = side * (.32 + t * (chain > 2 ? 1.6 : 1.25));
+
+      // Expanding impact ring and secondary chromatic halo.
+      for (var ring = 0; ring < 2; ring++) {
+        final progress = ((t + ring * .16) / (1 + ring * .16)).clamp(0.0, 1.0);
+        final radius = side * (.16 + progress * (ring == 0 ? .94 : 1.43));
+        canvas.drawCircle(center, radius, Paint()
+          ..style = PaintingStyle.stroke
+          ..strokeWidth = (ring == 0 ? 3.2 : 1.5) * (1 - progress) + .2
+          ..color = (ring == 0 ? Colors.white : color)
+              .withValues(alpha: (1 - progress) * .72 * fade));
+      }
+      // Luminous impact core.
+      canvas.drawCircle(center, side * (.25 + t * .22), Paint()
+        ..color = color.withValues(alpha: .46 * fade));
+      canvas.drawCircle(center, side * (.12 + t * .12), Paint()
+        ..color = Colors.white.withValues(alpha: .93 * fade));
+
+      // Crystal shards: deterministic orientation avoids per-frame random work.
+      for (var part = 0; part < 11; part++) {
+        final theta = (part + rng.nextDouble() * .58) * math.pi * 2 / 11;
+        final speed = .52 + rng.nextDouble() * .67;
+        final dx = math.cos(theta), dy = math.sin(theta);
+        final distance = burst * speed * (1 - (1 - t) * (1 - t));
+        final origin = center + Offset(dx * distance, dy * distance + t * t * side * .27);
+        final length = side * (.12 + rng.nextDouble() * .14) * (1 - t * .58);
+        final width = length * (.32 + rng.nextDouble() * .33);
+        final perp = Offset(-dy * width, dx * width);
+        final tip = origin + Offset(dx * length, dy * length);
+        final back = origin - Offset(dx * length * .45, dy * length * .45);
+        final shard = Path()
+          ..moveTo(tip.dx, tip.dy)
+          ..lineTo((origin + perp).dx, (origin + perp).dy)
+          ..lineTo(back.dx, back.dy)
+          ..lineTo((origin - perp).dx, (origin - perp).dy)
+          ..close();
+        canvas.drawPath(shard, Paint()
+          ..color = Color.lerp(color, Colors.white, part.isEven ? .75 : .32)!
+              .withValues(alpha: (.82 - .34 * t) * fade));
+        if (part.isEven) {
+          final streakStart = origin - Offset(dx * side * .16, dy * side * .16);
+          canvas.drawLine(streakStart, origin, Paint()
+            ..strokeWidth = 1.2 * (1 - t) + .3
+            ..strokeCap = StrokeCap.round
+            ..color = Colors.white.withValues(alpha: .65 * fade));
+        }
+      }
+
+      // Fine sparks / high-frequency glints complement larger fragments.
+      for (var spark = 0; spark < 10; spark++) {
+        final angle = (spark + rng.nextDouble()) * math.pi * 2 / 10;
+        final radius = burst * (.45 + rng.nextDouble() * .95);
+        final pos = center + Offset(math.cos(angle) * radius, math.sin(angle) * radius);
+        final sparklePaint = Paint()..color = Colors.white.withValues(alpha: .95 * fade);
+        final length = side * .037 * (1 - t * .5);
+        canvas.drawLine(pos.translate(-length, 0), pos.translate(length, 0), sparklePaint..strokeWidth = 1.25);
+        canvas.drawLine(pos.translate(0, -length), pos.translate(0, length), sparklePaint);
+      }
+    }
+
+    if (chain > 1 && t < .82) {
+      // Compact floating cascade emphasis rather than a full-screen overlay.
+      final point = active.first;
+      final anchor = Offset(((point % 7) + .5) * side, ((point ~/ 7) + .5) * side);
+      final label = TextPainter(
+        text: TextSpan(text: 'x$chain COMBO', style: TextStyle(
+          color: Colors.white.withValues(alpha: (1 - t).clamp(0.0, 1.0)),
+          fontSize: 14.0 + chain.clamp(0, 5).toDouble() * 1.2,
+          fontWeight: FontWeight.w900, letterSpacing: 1.2,
+          shadows: <Shadow>[Shadow(color: palette[0], blurRadius: 10)],
+        )),
+        textDirection: TextDirection.ltr,
+      )..layout();
+      label.paint(canvas, Offset(
+        (anchor.dx - label.width / 2).clamp(0.0, math.max(0.0, size.width - label.width)).toDouble(),
+        (anchor.dy - side * .85 - t * side * .8).clamp(0.0, math.max(0.0, size.height - label.height)).toDouble(),
+      ));
+    }
+    canvas.restore();
+  }
+
+  @override
+  bool shouldRepaint(covariant AnimalCrystalBurst old) =>
+      old.cells != cells || old.before != before || old.chain != chain ||
+      old.palette != palette || old.animation != animation;
+}
