+
+void main() {
+  test('every animated cascade contains safe immutable board snapshots', () {
+    for (var level = 1; level <= 100; level += 7) {
+      for (var seed = 0; seed < 9; seed++) {
+        final engine = AnimalMatchEngine(AnimalMatchLevel(level),
+            random: Random(level * 137 + seed));
+        var actions = 0;
+        while (!engine.ended && actions < 20) {
+          AnimalMatchResult? move;
+          for (var index = 0; index < AnimalMatchEngine.cells && move == null; index++) {
+            for (final offset in <int>[1, AnimalMatchEngine.width]) {
+              final other = index + offset;
+              if (other >= AnimalMatchEngine.cells) continue;
+              if (offset == 1 && index ~/ AnimalMatchEngine.width !=
+                  other ~/ AnimalMatchEngine.width) continue;
+              final result = engine.swap(index, other);
+              if (result.valid) {move = result; break;}
+            }
+          }
+          expect(move, isNotNull, reason: 'No legal move at $level:$seed:$actions');
+          expect(move!.steps, isNotEmpty);
+          expect(move.steps.length, lessThanOrEqualTo(30));
+          for (final step in move.steps) {
+            expect(step.before.length, AnimalMatchEngine.cells);
+            expect(step.after.length, AnimalMatchEngine.cells);
+            expect(step.fallDistances.length, AnimalMatchEngine.cells);
+            expect(step.clearedCells, isNotEmpty);
+            expect(step.fallDistances.every((n) => n >= 0 && n <= 8), isTrue);
+            expect(step.before.every((n) => n >= 0 && n < AnimalMatchEngine.kinds), isTrue);
+            expect(step.after.every((n) => n >= 0 && n < AnimalMatchEngine.kinds), isTrue);
+          }
+          expect(engine.board.every((n) => n >= 0 && n < 6), isTrue);
+          if (!engine.ended) {
+            expect(engine.hasExistingMatches, isFalse);
+            expect(engine.hasPossibleSwap, isTrue);
+          }
+          actions++;
+        }
+      }
+    }
+  });
+
+  test('hammer and rainbow return deterministic explosion and falling frames', () {
+    final engine = AnimalMatchEngine(AnimalMatchLevel(1), random: Random(21));
+    final before = List<int>.of(engine.board);
+    final hit = engine.hammer(15);
+    expect(hit.valid, isTrue);
+    expect(hit.steps.first.clearedCells, <int>{15});
+    expect(hit.steps.first.before, before);
+    expect(hit.steps.first.after.length, AnimalMatchEngine.cells);
+    if (!engine.ended) {
+      final count = engine.orbs;
+      final orb = engine.rainbow();
+      expect(orb.valid, isTrue);
+      expect(orb.steps, isNotEmpty);
+      expect(engine.orbs, count - 1);
+    }
+  });
+
+  test('rainbow booster cannot be consumed when its target color is absent', () {
+    final engine = AnimalMatchEngine(AnimalMatchLevel(2), random: Random(51));
+    final other = (engine.level.featuredGem + 1) % AnimalMatchEngine.kinds;
+    engine.board.fillRange(0, AnimalMatchEngine.cells, other);
+    final remaining = engine.orbs;
+    final result = engine.rainbow();
+    expect(result.valid, isFalse);
+    expect(engine.orbs, remaining);
+  });
+}
