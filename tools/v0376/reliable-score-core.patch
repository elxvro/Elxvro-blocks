+import 'dart:async';
+import 'dart:convert';
+
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// A crash-safe retry queue for high-score leaderboards.
+///
+/// Google Play Games keeps the maximum score submitted for each leaderboard.
+/// Accordingly, multiple local submissions are coalesced to the maximum score
+/// for that leaderboard. Failed submissions remain on the device and are
+/// retried on the next successful Play Games sign-in.
+///
+/// This storage is local to the app installation; it is not a user-account
+/// backup or a substitute for published Google Play Games leaderboards.
+class PendingLeaderboardScores {
+  const PendingLeaderboardScores();
+
+  static const String storageKey = 'elxvro_play_games_pending_scores_v1';
+
+  // All service instances share the same preferences key. Serialize the entire
+  // read/write/flush operation to avoid a late save overwriting a newer score.
+  static Future<void> _tail = Future<void>.value();
+
+  Future<T> _exclusive<T>(Future<T> Function() action) async {
+    final previous = _tail;
+    final done = Completer<void>();
+    _tail = done.future;
+    await previous;
+    try {
+      return await action();
+    } finally {
+      done.complete();
+    }
+  }
+
+  Future<Map<String, int>> _read(SharedPreferences prefs) async {
+    final raw = prefs.getString(storageKey);
+    if (raw == null || raw.isEmpty) return <String, int>{};
+    try {
+      final value = jsonDecode(raw);
+      if (value is! Map<String, dynamic>) return <String, int>{};
+      final pending = <String, int>{};
+      for (final entry in value.entries) {
+        if (entry.key.trim().isEmpty || entry.value is! int) continue;
+        final score = entry.value as int;
+        if (score >= 0) pending[entry.key] = score;
+      }
+      return pending;
+    } on FormatException {
+      // A corrupt preference should not crash a game-over screen.
+      return <String, int>{};
+    }
+  }
+
+  Future<void> _write(SharedPreferences prefs, Map<String, int> pending) async {
+    final saved = await prefs.setString(storageKey, jsonEncode(pending));
+    if (!saved) throw StateError('Failed to persist pending Play Games scores');
+  }
+
+  Future<void> enqueue({required String leaderboardId, required int score}) {
+    final id = leaderboardId.trim();
+    if (id.isEmpty) return Future<void>.value();
+    final normalized = score < 0 ? 0 : score;
+    return _exclusive(() async {
+      final prefs = await SharedPreferences.getInstance();
+      final pending = await _read(prefs);
+      if ((pending[id] ?? -1) >= normalized) return;
+      pending[id] = normalized;
+      await _write(prefs, pending);
+    });
+  }
+
+  Future<int?> pendingFor(String leaderboardId) => _exclusive(() async {
+    final prefs = await SharedPreferences.getInstance();
+    return (await _read(prefs))[leaderboardId.trim()];
+  });
+
+  /// A failed item is retained. Successful items are removed *after* the
+  /// platform call completes, so a process crash can only cause an idempotent
+  /// repeat submission, not the loss of a score.
+  Future<int> flush(Future<void> Function(String id, int score) send) {
+    return _exclusive(() async {
+      final prefs = await SharedPreferences.getInstance();
+      final pending = await _read(prefs);
+      var sent = 0;
+      for (final entry in pending.entries.toList(growable: false)) {
+        try {
+          await send(entry.key, entry.value);
+        } catch (_) {
+          continue;
+        }
+        pending.remove(entry.key);
+        await _write(prefs, pending);
+        sent++;
+      }
+      return sent;
+    });
+  }
+}
