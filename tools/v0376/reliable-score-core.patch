--- a/test/v0376_score_sync_test.dart
+++ b/test/v0376_score_sync_test.dart
@@ -0,0 +1,111 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:elxvro_blocks/services/pending_leaderboard_scores.dart';
+import 'package:elxvro_blocks/services/play_games_ids.dart';
+import 'package:elxvro_blocks/services/play_games_service.dart';
+
+class RetryGamesAdapter implements GamesPlatformAdapter {
+  bool connected = true;
+  bool failSubmissions = false;
+  final submissions = <(String, int)>[];
+  int signIns = 0;
+
+  @override
+  Future<bool> signIn() async { signIns++; return connected; }
+
+  @override
+  Future<void> submitScore({required String leaderboardId, required int score}) async {
+    if (failSubmissions) throw StateError('Network unavailable');
+    submissions.add((leaderboardId, score));
+  }
+
+  @override
+  Future<void> showLeaderboard({required String leaderboardId}) async {}
+  @override
+  Future<void> showLeaderboards() async {}
+  @override
+  Future<void> showAchievements() async {}
+  @override
+  Future<void> unlockAchievement(String achievementId) async {}
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUp(() => SharedPreferences.setMockInitialValues(<String, Object>{}));
+
+  const ids = PlayGamesIds(
+    classicLeaderboardId: 'classic',
+    comboRushLeaderboardId: 'rush',
+    fallingBlocksLeaderboardId: 'falling',
+    worldAdventureLeaderboardId: 'worlds',
+    achievementIds: <String, String>{},
+  );
+
+  test('offline score remains on disk and is retried by a new service', () async {
+    final offline = RetryGamesAdapter()..connected = false;
+    final oldService = PlayGamesService(ids: ids, adapter: offline);
+    await oldService.submitScore(leaderboardId: 'classic', score: 4321);
+    expect(offline.submissions, isEmpty);
+    expect(await const PendingLeaderboardScores().pendingFor('classic'), 4321);
+
+    final online = RetryGamesAdapter();
+    final newService = PlayGamesService(ids: ids, adapter: online);
+    expect(await newService.signIn(), isTrue);
+    expect(online.submissions, <(String, int)>[('classic', 4321)]);
+    expect(await const PendingLeaderboardScores().pendingFor('classic'), isNull);
+  });
+
+  test('queue retains highest pending score per independent leaderboard', () async {
+    final offline = RetryGamesAdapter()..connected = false;
+    final service = PlayGamesService(ids: ids, adapter: offline);
+    await service.submitScore(leaderboardId: 'classic', score: 100);
+    await service.submitScore(leaderboardId: 'classic', score: 500);
+    await service.submitScore(leaderboardId: 'classic', score: 300);
+    await service.submitScore(leaderboardId: 'falling', score: 280);
+    await service.submitScore(leaderboardId: 'worlds', score: 93);
+
+    final queue = const PendingLeaderboardScores();
+    expect(await queue.pendingFor('classic'), 500);
+    expect(await queue.pendingFor('falling'), 280);
+    expect(await queue.pendingFor('worlds'), 93);
+
+    final online = RetryGamesAdapter();
+    await PlayGamesService(ids: ids, adapter: online).signIn();
+    expect(online.submissions.toSet(), <(String, int)>{
+      ('classic', 500), ('falling', 280), ('worlds', 93),
+    });
+    expect(online.submissions.length, 3);
+    expect(await queue.pendingFor('classic'), isNull);
+    expect(await queue.pendingFor('falling'), isNull);
+    expect(await queue.pendingFor('worlds'), isNull);
+  });
+
+  test('failed remote submission is never deleted before acknowledgment', () async {
+    final adapter = RetryGamesAdapter()..failSubmissions = true;
+    final service = PlayGamesService(ids: ids, adapter: adapter);
+    await service.submitScore(leaderboardId: 'classic', score: 9999);
+    expect(await const PendingLeaderboardScores().pendingFor('classic'), 9999);
+    adapter.failSubmissions = false;
+    await PlayGamesService(ids: ids, adapter: adapter).signIn();
+    expect(adapter.submissions, <(String, int)>[('classic', 9999)]);
+    expect(await const PendingLeaderboardScores().pendingFor('classic'), isNull);
+  });
+
+  test('a score that cannot be persisted does not create fake leaderboard results', () async {
+    final queue = const PendingLeaderboardScores();
+    await queue.enqueue(leaderboardId: '', score: 100);
+    expect(await queue.pendingFor(''), isNull);
+    await queue.enqueue(leaderboardId: 'falling', score: -30);
+    expect(await queue.pendingFor('falling'), 0);
+  });
+
+  test('two simultaneous writers preserve the highest record', () async {
+    final queue = const PendingLeaderboardScores();
+    await Future.wait(<Future<void>>[
+      queue.enqueue(leaderboardId: 'classic', score: 100),
+      queue.enqueue(leaderboardId: 'classic', score: 600),
+      queue.enqueue(leaderboardId: 'classic', score: 300),
+    ]);
+    expect(await queue.pendingFor('classic'), 600);
+  });
+}
