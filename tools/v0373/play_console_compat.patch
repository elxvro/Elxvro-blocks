--- a/test/v0373_play_console_checks_test.dart
+++ b/test/v0373_play_console_checks_test.dart
@@ -0,0 +1,43 @@
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('release has a monotonic Play version and keeps the original app id', () {
+    final pubspec = File('pubspec.yaml').readAsStringSync();
+    expect(pubspec, contains('version: 0.37.3+101'));
+    final android = File('tool/apply_android_compat.py').readAsStringSync();
+    expect(android, contains('compileSdk = 36'));
+    expect(android, contains('WindowCompat.setDecorFitsSystemWindows(window, false)')); 
+    expect(android, isNot(contains('WindowCompat.enableEdgeToEdge(window)')));
+  });
+
+  test('Flutter declares edge-to-edge and screens handle inset areas', () {
+    final main = File('lib/main.dart').readAsStringSync();
+    expect(main, contains('SystemUiMode.edgeToEdge'));
+    expect(main, contains('SafeArea('));
+    for (final name in <String>['home_screen', 'launch_screen', 'animal_adventure_screen']) {
+      final source = File('lib/screens/$name.dart').readAsStringSync();
+      expect(source, contains('SafeArea('), reason: '$name must protect system insets');
+    }
+  });
+
+  test('animal sprites and material textures are decoded at display sizes', () {
+    final world = File('lib/screens/animal_adventure_screen.dart').readAsStringSync();
+    expect(world, contains('Image.asset(world.stageImage(1), cacheWidth: 192'));
+    expect(world, contains('Image.asset(widget.world.stageImage(level), cacheWidth: 192'));
+    expect(world, contains('Image.asset(widget.world.gemImage(species), cacheWidth: 192'));
+    final tiles = File('lib/widgets/themed_block_tile.dart').readAsStringSync();
+    expect(tiles, contains('cacheWidth: 192'));
+    final fragments = File('lib/widgets/material_fragment_fx.dart').readAsStringSync();
+    expect(fragments, contains('cacheWidth: 48'));
+  });
+
+  test('progress persistence, in-app purchases and Play Games remain', () {
+    expect(File('lib/services/animal_match_progress.dart').existsSync(), isTrue);
+    expect(File('lib/services/world_match_progress.dart').existsSync(), isTrue);
+    expect(File('lib/services/developer_support_service.dart').existsSync(), isTrue);
+    expect(File('lib/services/play_games_service.dart').existsSync(), isTrue);
+    expect(Directory('assets/images/world_stages/animals').existsSync(), isTrue);
+    expect(Directory('assets/images/world_stages/vehicles').existsSync(), isTrue);
+  });
+}
