diff --git a/test/v0340_crystal_premium_test.dart b/test/v0340_crystal_premium_test.dart
new file mode 100644
index 0000000..7554f5c
--- /dev/null
+++ b/test/v0340_crystal_premium_test.dart
@@ -0,0 +1,136 @@
+import 'dart:math';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:elxvro_blocks/game/animal_match_engine.dart';
+import 'package:elxvro_blocks/services/animal_match_progress.dart';
+import 'package:elxvro_blocks/widgets/animal_crystal_burst.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  setUp(() {
+    AnimalMatchProgress.nativeStorageEnabled = false;
+    SharedPreferences.setMockInitialValues(<String, Object>{'coins': 800});
+  });
+
+  test('obstacles begin gradually and mature into stone and chains', () {
+    expect(AnimalMatchLevel(1).obstacleCount, 0);
+    expect(AnimalMatchLevel(7).obstacleCount, 0);
+    expect(AnimalMatchLevel(8).obstacleCount, greaterThan(0));
+    expect(AnimalMatchLevel(21).hasChains, false);
+    expect(AnimalMatchLevel(22).hasChains, true);
+    expect(AnimalMatchLevel(39).hasStone, true);
+    expect(AnimalMatchLevel(100).obstacleCount,
+        greaterThan(AnimalMatchLevel(8).obstacleCount));
+    expect(AnimalMatchLevel(5).milestoneBonus, greaterThan(0));
+    expect(AnimalMatchLevel(4).milestoneBonus, 0);
+  });
+
+  test('locked gems cannot be swapped; breaking barrier requires impact', () {
+    final game = AnimalMatchEngine(AnimalMatchLevel(44), random: Random(71));
+    expect(game.remainingObstacles, game.level.obstacleCount);
+    final locked = game.blockers.indexWhere((x) => x != 0);
+    expect(locked, isNonNegative);
+    final neighbor = locked % AnimalMatchEngine.width == 0 ? locked + 1 : locked - 1;
+    final remainingMoves = game.movesLeft;
+    expect(game.swap(locked, neighbor).valid, false);
+    expect(game.movesLeft, remainingMoves);
+    // Every hammer hit is real and fractures the obstruction without
+    // charging an extra move. Solid stone needs a second hit.
+    game.hammers = 2;
+    final first = game.barrierAt(locked);
+    final action = game.hammer(locked);
+    expect(action.valid, true);
+    expect(action.steps.first.fracturedBlockers, contains(locked));
+    expect(game.barrierAt(locked), isNot(first));
+    if (first == 3) {
+      game.hammer(locked);
+      expect(game.barrierAt(locked), 0);
+    }
+    expect(game.movesLeft, remainingMoves);
+  });
+
+  test('all 100 levels are playable and avoid matched / deadlocked states', () {
+    for (final levelNumber in <int>[1, 8, 22, 39, 65, 100]) {
+      for (var seed = 0; seed < 8; seed++) {
+        final game = AnimalMatchEngine(AnimalMatchLevel(levelNumber),
+            random: Random(seed + 104));
+        expect(game.remainingObstacles, game.level.obstacleCount);
+        expect(game.hasPossibleSwap, isTrue);
+        expect(game.hasExistingMatches, isFalse);
+        for (var move = 0; move < 3 && !game.ended; move++) {
+          AnimalMatchResult? completed;
+          for (var i = 0; i < AnimalMatchEngine.cells && completed == null; i++) {
+            for (final delta in <int>[1, AnimalMatchEngine.width]) {
+              final j = i + delta;
+              if (j >= AnimalMatchEngine.cells) continue;
+              if (delta == 1 && i ~/ AnimalMatchEngine.width !=
+                  j ~/ AnimalMatchEngine.width) continue;
+              final action = game.swap(i, j);
+              if (action.valid) {
+                completed = action;
+                break;
+              }
+            }
+          }
+          expect(completed, isNotNull, reason: 'No move: $levelNumber/$seed');
+          for (final step in completed!.steps) {
+            expect(step.blockersBefore.length, AnimalMatchEngine.cells);
+            expect(step.blockersAfter.length, AnimalMatchEngine.cells);
+          }
+          if (!game.ended) {
+            expect(game.hasExistingMatches, isFalse);
+            expect(game.hasPossibleSwap, isTrue);
+          }
+        }
+      }
+    }
+  });
+
+  test('booster purchases survive reloading and are single-use', () async {
+    final p = AnimalMatchProgress();
+    await p.load();
+    expect(await p.purchaseBooster(1), true);
+    expect(p.boosterStock[1], 1);
+    expect(p.storedCoinBalance, 620);
+    final reloaded = AnimalMatchProgress();
+    await reloaded.load();
+    expect(reloaded.boosterStock[1], 1);
+    expect(await reloaded.consumeBooster(1), true);
+    expect(await reloaded.consumeBooster(1), false);
+    expect(reloaded.boosterStock[1], 0);
+    expect(await reloaded.purchaseBooster(99), false);
+  });
+
+  test('daily chest rewards once, and quest waits for 3 first-time wins', () async {
+    final p = AnimalMatchProgress();
+    await p.load();
+    expect(p.questReady, false);
+    expect(p.chestReady, true);
+    expect(await p.claimCrystalReward(quest: false), 60);
+    expect(await p.claimCrystalReward(quest: false), 0);
+    expect(p.chestReady, false);
+    expect(await p.claimCrystalReward(quest: true), 0);
+    await p.recordWin(1, 1);
+    await p.recordWin(2, 1);
+    await p.recordWin(3, 2);
+    expect(p.dailyQuestWins, 3);
+    expect(p.questReady, true);
+    expect(await p.claimCrystalReward(quest: true), 120);
+    expect(await p.claimCrystalReward(quest: true), 0);
+    final reloaded = AnimalMatchProgress();
+    await reloaded.load();
+    expect(reloaded.chestReady, false);
+    expect(reloaded.questReady, false);
+  });
+
+  test('crystal storm intensity increases without an unbounded work budget', () {
+    const small = CrystalImpactProfile(matched: 3, chain: 1);
+    const large = CrystalImpactProfile(matched: 24, chain: 5);
+    expect(large.force, greaterThan(small.force));
+    expect(large.shardsPerGem, greaterThan(small.shardsPerGem));
+    expect(large.maxImpactCells *
+      (large.shardsPerGem + large.sparksPerGem), lessThan(2500));
+  });
+}
