+  const CrystalObstacleOverlay({super.key, required this.kind});
+  final int kind;
+
+  @override
+  Widget build(BuildContext context) {
+    if (kind == 0) return const SizedBox.shrink();
+    return IgnorePointer(child: RepaintBoundary(child: CustomPaint(
+      painter: _CrystalObstaclePainter(kind),
+      child: const SizedBox.expand(),
+    )));
+  }
+}
+
+class _CrystalObstaclePainter extends CustomPainter {
+  const _CrystalObstaclePainter(this.kind);
+  final int kind;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final w = size.width, h = size.height;
+    if (w <= 0 || h <= 0) return;
+    final rect = Offset.zero & size;
+    final paint = Paint()..isAntiAlias = true;
+    if (kind == 1) {
+      paint.color = const Color(0xAA9AF4FF);
+      canvas.drawRRect(RRect.fromRectAndRadius(rect.deflate(w * .045),
+          Radius.circular(w * .16)), paint);
+      paint.color = const Color(0xCCFFFFFF);
+      paint.style = PaintingStyle.stroke;
+      paint.strokeWidth = math.max(.9, w * .035);
+      canvas.drawLine(Offset(w * .12, h * .23), Offset(w * .48, h * .63), paint);
+      canvas.drawLine(Offset(w * .48, h * .63), Offset(w * .78, h * .18), paint);
+      canvas.drawLine(Offset(w * .48, h * .63), Offset(w * .85, h * .81), paint);
+    } else if (kind == 2) {
+      paint.color = const Color(0xE6FFCF69);
+      paint.style = PaintingStyle.stroke;
+      paint.strokeWidth = math.max(2, w * .085);
+      for (var i = 0; i < 3; i++) {
+        canvas.drawOval(Rect.fromCenter(
+            center: Offset(w * (.25 + .25 * i), h * (.25 + .25 * i)),
+            width: w * .53, height: h * .32), paint);
+      }
+      paint.color = const Color(0xBB381D18);
+      paint.strokeWidth = w * .025;
+      canvas.drawLine(Offset(w * .18, h * .08), Offset(w * .90, h * .88), paint);
+    } else {
+      final stone = Path()
+        ..moveTo(w * .17, h * .16)..lineTo(w * .75, h * .06)
+        ..lineTo(w * .96, h * .51)..lineTo(w * .76, h * .95)
+        ..lineTo(w * .16, h * .87)..lineTo(w * .03, h * .49)..close();
+      canvas.drawPath(stone, paint..style = PaintingStyle.fill
+        ..color = kind == 3 ? const Color(0xF056627E)
+                           : const Color(0xB66E809E));
+      canvas.drawPath(stone, paint..style = PaintingStyle.stroke
+        ..strokeWidth = math.max(1, w * .05)
+        ..color = const Color(0xFFE1EAFB));
+      paint.color = const Color(0xFFF7D8A1);
+      paint.strokeWidth = math.max(1, w * .05);
+      canvas.drawLine(Offset(w * .50, h * .12), Offset(w * .38, h * .44), paint);
+      canvas.drawLine(Offset(w * .38, h * .44), Offset(w * .66, h * .57), paint);
+      if (kind == 4) {
+        canvas.drawLine(Offset(w * .38, h * .44), Offset(w * .19, h * .76), paint);
+        canvas.drawLine(Offset(w * .66, h * .57), Offset(w * .84, h * .82), paint);
+      }
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _CrystalObstaclePainter oldDelegate) =>
+      oldDelegate.kind != kind;
+}
