+import 'dart:math';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:elxvro_blocks/game/animal_match_engine.dart';
+import 'package:elxvro_blocks/services/animal_match_progress.dart';
+import 'package:elxvro_blocks/widgets/animal_crystal_burst.dart';
+
+AnimalMatchResult _firstLegalMove(AnimalMatchEngine game) {
+  for (var i = 0; i < AnimalMatchEngine.cells; i++) {
+    for (final delta in <int>[1, AnimalMatchEngine.width]) {
+      final to = i + delta;
+      if (to >= AnimalMatchEngine.cells ||
+          delta == 1 && i ~/ AnimalMatchEngine.width !=
+          to ~/ AnimalMatchEngine.width) continue;
+      final result = game.swap(i, to);
+      if (result.valid) return result;
+    }
+  }
+  throw StateError('Board is not playable');
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUp(() {
+    AnimalMatchProgress.nativeStorageEnabled = false;
+    SharedPreferences.setMockInitialValues(<String, Object>{'coins': 120});
+  });
+
+  test('boss appears on exactly the existing ten-stage milestones', () {
+    for (var i = 1; i <= 100; i++) {
+      final level = AnimalMatchLevel(i);
+      expect(level.isBoss, i % 10 == 0);
+      expect(level.bossMaxHealth > 0, level.isBoss);
+    }
+    expect(AnimalMatchLevel(100).bossMaxHealth,
+        greaterThan(AnimalMatchLevel(10).bossMaxHealth));
+    expect(AnimalMatchLevel(10).victoryReward,
+        greaterThan(AnimalMatchLevel(10).baseReward));
+  });
+
+  test('boss takes match damage and attacks without deadlocking game', () {
+    final engine = AnimalMatchEngine(AnimalMatchLevel(10),
+        random: Random(18));
+    final initial = engine.bossHealth;
+    for (var move = 0; move < 5 && !engine.ended; move++) {
+      final result = _firstLegalMove(engine);
+      expect(result.cleared, greaterThan(0));
+      expect(engine.bossHealth, lessThan(initial));
+      expect(engine.bossHealth, greaterThanOrEqualTo(0));
+      if (!engine.ended) expect(engine.hasPossibleSwap, true);
+    }
+    expect(engine.bossAttacks, greaterThanOrEqualTo(1));
+    expect(engine.remainingObstacles,
+        greaterThanOrEqualTo(0));
+  });
+
+  test('special crystals trigger real clears even without a normal match', () {
+    for (final power in <int>[1, 2, 3, 4]) {
+      final engine = AnimalMatchEngine(AnimalMatchLevel(1),
+          random: Random(100 + power));
+      engine.specials[0] = power;
+      final before = engine.movesLeft;
+      final result = engine.swap(0, 1);
+      expect(result.valid, true, reason: 'Special $power did not activate');
+      expect(result.cleared, greaterThanOrEqualTo(2));
+      expect(engine.movesLeft, before - 1);
+      expect(result.steps, isNotEmpty);
+      expect(result.steps.first.specialsAfter.length,
+          AnimalMatchEngine.cells);
+      expect(engine.board.every((x) => x >= 0 && x < 6), true);
+    }
+  });
+
+  test('special-crystal frames and fragments have a strict FX budget', () {
+    const mega = CrystalImpactProfile(matched: 40, chain: 7);
+    expect(mega.mega, true);
+    expect(mega.maxImpactCells *
+        (mega.shardsPerGem + mega.sparksPerGem), lessThan(2500));
+  });
+
+  test('weekly quest pays once after five distinct new levels', () async {
+    final progress = AnimalMatchProgress();
+    await progress.load();
+    expect(progress.weeklyReady, false);
+    for (var level = 1; level <= 5; level++) {
+      expect(await progress.recordWin(level, 2), true);
+      expect(await progress.recordWin(level, 2), false);
+    }
+    expect(progress.weeklyWins, 5);
+    expect(progress.weeklyReady, true);
+    expect(await progress.claimWeeklyReward(), 240);
+    expect(await progress.claimWeeklyReward(), 0);
+    expect(progress.weeklyReady, false);
+    final restored = AnimalMatchProgress();
+    await restored.load();
+    expect(restored.weeklyWins, 5);
+    expect(restored.weeklyReady, false);
+    expect(restored.completed.length, 5);
+    expect(await restored.claimWeeklyReward(), 0);
+  });
+
+  test('mastery badge milestones depend on distinct completed stages', () async {
+    final p = AnimalMatchProgress();
+    await p.load();
+    expect(p.achievementBadges, 0);
+    for (var i = 1; i <= 10; i++) {
+      await p.recordWin(i, 1);
+    }
+    expect(p.achievementBadges, 1);
+    expect(p.completed.length, 10);
+  });
+}
