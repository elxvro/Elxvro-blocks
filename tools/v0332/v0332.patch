+++ b/lib/game/falling_piece_bag.dart
@@ -0,0 +1,32 @@
+import 'dart:math';
+
+/// All seven tetromino shapes appear once per bag. Adjacent pieces are never
+/// identical, including across bag boundaries. Colors remain theme-driven.
+class FallingPieceBag {
+  FallingPieceBag({Random? random}) : _random = random ?? Random();
+  final Random _random;
+  final List<int> _bag = <int>[];
+  int? _previous;
+
+  int next() {
+    if (_bag.isEmpty) {
+      _bag.addAll(List<int>.generate(7, (i) => i));
+      _bag.shuffle(_random);
+      // Shuffle can place the previously played shape at the boundary.
+      if (_bag.first == _previous) {
+        final swap = 1 + _random.nextInt(_bag.length - 1);
+        final first = _bag[0];
+        _bag[0] = _bag[swap];
+        _bag[swap] = first;
+      }
+    }
+    final shape = _bag.removeAt(0);
+    _previous = shape;
+    return shape;
+  }
+
+  void reset() {
+    _bag.clear();
+    _previous = null;
+  }
+}
--- a/test/v0332_regressions_test.dart
+++ b/test/v0332_regressions_test.dart
@@ -0,0 +1,82 @@
+import 'dart:math';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:elxvro_blocks/app_state.dart';
+import 'package:elxvro_blocks/game/falling_piece_bag.dart';
+import 'package:elxvro_blocks/screens/animal_adventure_screen.dart';
+import 'package:elxvro_blocks/services/animal_match_progress.dart';
+
+class _BrokenProgress extends AnimalMatchProgress {
+  @override
+  Future<void> load() async => throw StateError('simulated device preference failure');
+}
+
+class _FlakyProgress extends AnimalMatchProgress {
+  int attempts = 0;
+  @override
+  Future<void> load() async {
+    attempts++;
+    if (attempts == 1) throw StateError('first load failed');
+    await super.load();
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUp(() => SharedPreferences.setMockInitialValues(<String, Object>{}));
+
+  test('every bag draws seven distinct shapes, and boundaries never repeat', () {
+    final bag = FallingPieceBag(random: Random(17));
+    int? previous;
+    for (var bagIndex = 0; bagIndex < 150; bagIndex++) {
+      final current = List<int>.generate(7, (_) => bag.next());
+      expect(current.toSet().length, 7);
+      expect(current.toSet(), <int>{0, 1, 2, 3, 4, 5, 6});
+      if (previous != null) expect(current.first, isNot(previous));
+      previous = current.last;
+    }
+  });
+
+  testWidgets('progress load failure must not hide 100 levels', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(360, 780));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final state = AppState();
+    await state.load();
+    await tester.pumpWidget(MaterialApp(home: AnimalAdventureScreen(
+      appState: state, progress: _BrokenProgress(),
+    )));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    expect(find.textContaining('100 BÖLÜM'), findsWidgets);
+    expect(find.text('Tilki'), findsWidgets);
+    expect(find.text('Bölümler yüklenemedi'), findsNothing);
+    expect(find.textContaining('Kayıt okunamadı'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('retry restores normal progress without dropping user data', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(360, 780));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'animal_match_unlocked_v1': 4,
+      'animal_match_completed_v1': <String>['1', '2', '3'],
+    });
+    final state = AppState();
+    await state.load();
+    final flaky = _FlakyProgress();
+    await tester.pumpWidget(MaterialApp(home: AnimalAdventureScreen(
+      appState: state, progress: flaky,
+    )));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    expect(find.textContaining('Kayıt okunamadı'), findsOneWidget);
+    await tester.tap(find.text('YENİLE'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    expect(find.textContaining('Kayıt okunamadı'), findsNothing);
+    expect(flaky.unlocked, 4);
+    expect(flaky.completed.length, 3);
+  });
+}
