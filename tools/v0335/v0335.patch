+
+class _VictoryConfetti extends CustomPainter {
+  _VictoryConfetti({required this.animation, required this.enabled})
+      : super(repaint: animation);
+  final Animation<double> animation;
+  final bool enabled;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (!enabled) return;
+    final t = animation.value;
+    const colors = <Color>[
+      Color(0xFFFFD674), Color(0xFF73E9FF), Color(0xFFE1A2FF),
+      Color(0xFF83F4C3), Color(0xFFFF879A),
+    ];
+    final rng = math.Random(8731);
+    for (var i = 0; i < 130; i++) {
+      final x = rng.nextDouble() * size.width;
+      final y = rng.nextDouble() * size.height * .8;
+      final speed = .38 + rng.nextDouble() * .85;
+      final theta = rng.nextDouble() * math.pi * 2;
+      final position = Offset(
+        x + math.sin(theta) * 43 * t,
+        y - 140 * (1 - t) * speed + 250 * t * t * speed,
+      );
+      final side = 2.3 + rng.nextDouble() * 5;
+      final paint = Paint()..color = colors[i % colors.length]
+        .withValues(alpha: (1 - t * .7).clamp(0.0, 1.0).toDouble());
+      canvas.save();
+      canvas.translate(position.dx, position.dy);
+      canvas.rotate(t * (2 + i % 4));
+      canvas.drawRRect(RRect.fromRectAndRadius(
+        Rect.fromCenter(center: Offset.zero,
+          width: side, height: side * 2.5),
+        const Radius.circular(1.4)), paint);
+      canvas.restore();
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _VictoryConfetti old) =>
+      old.animation != animation || old.enabled != enabled;
+}
