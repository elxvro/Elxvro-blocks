+import 'dart:async';
+import 'dart:math';
+
+import 'package:elxvro_blocks/game/animal_match_engine.dart';
+import 'package:elxvro_blocks/screens/animal_match_result_screen.dart';
+import 'package:elxvro_blocks/widgets/animal_crystal_burst.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('all 100 levels increase the challenge without invalid values', () {
+    var lastTarget = 0;
+    var lastMoves = 100;
+    for (var n = 1; n <= 100; n++) {
+      final stage = AnimalMatchLevel(n);
+      expect(stage.target, greaterThan(lastTarget));
+      expect(stage.moves, lessThanOrEqualTo(lastMoves));
+      expect(stage.difficultyTier, inInclusiveRange(1, 10));
+      expect(stage.featuredGem, inInclusiveRange(0, 5));
+      lastTarget = stage.target;
+      lastMoves = stage.moves;
+    }
+    expect(AnimalMatchEngine.cells, 72);
+    expect(AnimalMatchLevel(100).baseReward,
+      greaterThan(AnimalMatchLevel(1).baseReward));
+  });
+
+  test('stronger gem unions increase particle counts and spread', () {
+    final normal = CrystalImpactProfile(matched: 3, chain: 1);
+    final multi = CrystalImpactProfile(matched: 8, chain: 1);
+    final mega = CrystalImpactProfile(matched: 16, chain: 6);
+    expect(normal.mega, false);
+    expect(multi.mega, true);
+    expect(mega.force, greaterThan(multi.force));
+    expect(multi.force, greaterThan(normal.force));
+    expect(mega.shardsPerGem, greaterThan(normal.shardsPerGem));
+    expect(mega.sparksPerGem, greaterThan(normal.sparksPerGem));
+    expect(mega.maxImpactCells, lessThanOrEqualTo(36));
+  });
+
+  test('cascades never leave an invalid or deadlocked board', () {
+    for (var seed = 0; seed < 25; seed++) {
+      final engine = AnimalMatchEngine(AnimalMatchLevel(15),
+        random: Random(seed));
+      for (var round = 0; round < 6 && !engine.ended; round++) {
+        var moved = false;
+        for (var a = 0; a < AnimalMatchEngine.cells && !moved; a++) {
+          for (final delta in <int>[1, AnimalMatchEngine.width]) {
+            final b = a + delta;
+            if (b >= AnimalMatchEngine.cells) continue;
+            if (delta == 1 && a ~/ AnimalMatchEngine.width !=
+                b ~/ AnimalMatchEngine.width) continue;
+            final result = engine.swap(a, b);
+            if (result.valid) {
+              expect(result.steps, isNotEmpty);
+              expect(engine.board.every((v) => v >= 0 && v < 6), true);
+              if (!engine.ended) {
+                expect(engine.hasExistingMatches, false);
+                expect(engine.hasPossibleSwap, true);
+              }
+              moved = true;
+              break;
+            }
+          }
+        }
+        expect(moved, true);
+      }
+    }
+  });
+
+  testWidgets('victory opens before save finishes and NEXT waits for save',
+      (tester) async {
+    await tester.binding.setSurfaceSize(const Size(390, 800));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final save = Completer<int>();
+    await tester.pumpWidget(MaterialApp(home: AnimalMatchResultScreen(
+      won: true,
+      level: 12,
+      animal: 'Kedi',
+      score: 3200,
+      stars: 3,
+      movesLeft: 8,
+      baseReward: 100,
+      rewardTask: save.future,
+      retryReward: () => save.future,
+      tr: true,
+    )));
+    await tester.pump();
+    expect(find.text('BÖLÜM TAMAMLANDI!'), findsOneWidget);
+    expect(find.text('İlerleme kaydediliyor…'), findsOneWidget);
+    final nextBefore = tester.widget<FilledButton>(
+      find.widgetWithText(FilledButton, 'SONRAKİ BÖLÜM'));
+    expect(nextBefore.onPressed, isNull);
+    save.complete(100);
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 30));
+    expect(find.text('+100'), findsOneWidget);
+    final nextAfter = tester.widget<FilledButton>(
+      find.widgetWithText(FilledButton, 'SONRAKİ BÖLÜM'));
+    expect(nextAfter.onPressed, isNotNull);
+  });
+}
